{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/controller-runtime-lease.v1.schema.json",
  "title": "Controller isolated VS Code runtime lease v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "scope", "launchId", "controllerRoot", "userDataDir",
    "extensionsDir", "codexHome", "codeCliCommand", "processIds", "createdAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scope": { "const": "single-machine" },
    "launchId": { "type": "string", "format": "uuid" },
    "controllerRoot": { "type": "string", "minLength": 3, "maxLength": 1024 },
    "userDataDir": { "type": "string", "minLength": 3, "maxLength": 1024 },
    "extensionsDir": { "type": "string", "minLength": 3, "maxLength": 1024 },
    "codexHome": { "type": "string", "minLength": 3, "maxLength": 1024 },
    "codeCliCommand": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "processIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "createdAtUtc": { "type": "string", "format": "date-time" }
  }
}
