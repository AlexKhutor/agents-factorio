{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/controller-wake-status.v1.schema.json",
  "title": "Controller wake processor status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "state", "processId", "eventId", "sourceId",
    "taskId", "stage", "updatedAtUtc", "problem"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "state": { "enum": ["processing", "controller-turn-started", "failed"] },
    "processId": { "type": "integer", "minimum": 1 },
    "eventId": { "type": ["string", "null"], "maxLength": 64 },
    "sourceId": { "type": ["string", "null"], "maxLength": 64 },
    "taskId": { "type": ["string", "null"], "maxLength": 96 },
    "stage": { "type": "string", "minLength": 1, "maxLength": 64 },
    "controllerThreadId": { "type": "string", "maxLength": 64 },
    "controllerTurnId": { "type": "string", "maxLength": 256 },
    "transport": { "enum": ["vscode-ui", "codex-app-server"] },
    "receipt": { "type": ["string", "null"], "maxLength": 512 },
    "updatedAtUtc": { "type": "string", "format": "date-time" },
    "problem": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 128 },
            "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        }
      ]
    }
  }
}
