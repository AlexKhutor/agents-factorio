{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-compatibility.v1.json",
  "title": "Application Compatibility v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "supportedApplicationContractVersions",
    "minimumClientVersion", "negotiationPolicy", "unknownOptionalFeaturePolicy",
    "unknownRequiredFeaturePolicy", "silentFallbackPolicy", "minimumClientBehaviors",
    "features", "supportWindows", "deprecations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.1.0" },
    "supportedApplicationContractVersions": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "#/$defs/version" }
    },
    "minimumClientVersion": { "$ref": "#/$defs/version" },
    "negotiationPolicy": { "const": "highest-mutually-supported" },
    "unknownOptionalFeaturePolicy": { "const": "ignore" },
    "unknownRequiredFeaturePolicy": { "const": "reject" },
    "silentFallbackPolicy": { "const": "deny" },
    "minimumClientBehaviors": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {
        "enum": [
          "ignore-unknown-optional-features", "reject-unknown-required-features",
          "reject-unsupported-contract-version", "preserve-operation-semantics",
          "deny-silent-fallback"
        ]
      }
    },
    "features": {
      "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/feature" }
    },
    "supportWindows": {
      "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/supportWindow" }
    },
    "deprecations": {
      "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/deprecation" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["featureId", "requirement", "status", "introducedIn"],
      "properties": {
        "featureId": { "$ref": "#/$defs/id" },
        "requirement": { "enum": ["required", "optional"] },
        "status": { "enum": ["enabled", "disabled"] },
        "introducedIn": { "$ref": "#/$defs/version" }
      }
    },
    "supportWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["contractId", "contractVersion", "status", "supportedUntilUtc"],
      "properties": {
        "contractId": { "$ref": "#/$defs/id" },
        "contractVersion": { "$ref": "#/$defs/version" },
        "status": { "enum": ["current", "supported", "deprecated"] },
        "supportedUntilUtc": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utc" }] }
      }
    },
    "deprecation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "noticeId", "contractId", "contractVersion", "announcedAtUtc",
        "effectiveAfterUtc", "replacementContractId", "replacementContractVersion"
      ],
      "properties": {
        "noticeId": { "$ref": "#/$defs/id" },
        "contractId": { "$ref": "#/$defs/id" },
        "contractVersion": { "$ref": "#/$defs/version" },
        "announcedAtUtc": { "$ref": "#/$defs/utc" },
        "effectiveAfterUtc": { "$ref": "#/$defs/utc" },
        "replacementContractId": { "$ref": "#/$defs/id" },
        "replacementContractVersion": { "$ref": "#/$defs/version" }
      }
    }
  }
}
