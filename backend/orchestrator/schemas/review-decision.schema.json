{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/review-decision.v1.json",
  "title": "Independent Child Report Review Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "sourceId",
    "reportSha256",
    "outcome",
    "summary",
    "acceptanceChecks",
    "decidedAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "reportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "outcome": { "enum": ["accepted", "rejected", "deferred", "superseded"] },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "acceptanceChecks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1, "maxLength": 512 },
          "status": { "enum": ["passed", "failed", "not-applicable", "not-verified"] },
          "evidence": { "type": "string", "maxLength": 1024 }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "maxLength": 512 }
    },
    "requiredFollowUps": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "maxLength": 512 }
    },
    "humanApprovalRequired": { "type": "boolean", "default": false },
    "decisionDocument": { "type": ["string", "null"], "maxLength": 1024 },
    "decidedAtUtc": { "type": "string", "format": "date-time" }
  }
}
