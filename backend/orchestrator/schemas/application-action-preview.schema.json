{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-action-preview.v0.1.0.json",
  "title": "Application High-Impact Action Preview v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "previewId", "actionId", "operation",
    "sourceSequence", "parametersSha256", "impactClasses", "effects",
    "generatedAtUtc", "previewSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.1.0" },
    "previewId": { "$ref": "#/$defs/id" },
    "actionId": { "$ref": "#/$defs/id" },
    "operation": {
      "allOf": [
        { "$ref": "https://isolate-vscode.local/schemas/application-operation-ref.v1.json" },
        { "type": "object", "properties": { "family": { "const": "mutation" } } }
      ]
    },
    "sourceSequence": { "type": "integer", "minimum": 0 },
    "parametersSha256": { "$ref": "#/$defs/sha256" },
    "impactClasses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": ["privileged", "destructive", "external-side-effect", "irreversible"]
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effectId", "effectType", "target", "beforeRevisionSha256",
          "proposedRevisionSha256"
        ],
        "properties": {
          "effectId": { "$ref": "#/$defs/id" },
          "effectType": {
            "enum": ["create", "update", "delete", "execute", "external-call", "permission-change"]
          },
          "target": {
            "$ref": "https://isolate-vscode.local/schemas/application-resource-ref.v1.json"
          },
          "beforeRevisionSha256": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
          },
          "proposedRevisionSha256": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
          }
        }
      }
    },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "previewSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
