{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-shadow-decision-report.v1.json",
  "title": "Application Shadow Decision Report v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "runId", "recordedAtUtc",
    "workflowCatalogVersion", "sources", "cases", "summary", "authority", "reportId"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.1.0" },
    "runId": { "$ref": "#/$defs/id" },
    "recordedAtUtc": { "$ref": "#/$defs/utc" },
    "workflowCatalogVersion": { "const": "v0.2.0" },
    "sources": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/$defs/source" }
    },
    "cases": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/case" }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["caseCount", "fake", "real"],
      "properties": {
        "caseCount": { "const": 3 },
        "fake": { "$ref": "#/$defs/counts" },
        "real": { "$ref": "#/$defs/counts" }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "productionMutationEnabled", "ownerConfirmationSynthesized"],
      "properties": {
        "kind": { "const": "bounded-shadow-authority" },
        "productionMutationEnabled": { "const": false },
        "ownerConfirmationSynthesized": { "const": false }
      }
    },
    "reportId": {
      "type": "string", "pattern": "^application-shadow-decision-[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": { "type": "string", "format": "date-time", "pattern": "Z$", "maxLength": 64 },
    "status": { "enum": ["succeeded", "unsupported", "unavailable", "failed"] },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "sourceKind"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "sourceKind": { "enum": ["fake-contract", "real-bounded"] }
      }
    },
    "sourceResult": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceId", "status", "reasonCode", "resultSha256", "evidenceIds"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "status": { "$ref": "#/$defs/status" },
        "reasonCode": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
          ]
        },
        "resultSha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "evidenceIds": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
        "then": {
          "properties": {
            "reasonCode": { "type": "null" },
            "resultSha256": { "$ref": "#/$defs/sha256" },
            "evidenceIds": { "type": "array", "minItems": 1 }
          }
        },
        "else": {
          "properties": {
            "reasonCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
            "resultSha256": { "type": "null" },
            "evidenceIds": { "type": "array", "maxItems": 0 }
          }
        }
      }]
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["workflowId", "fake", "real"],
      "properties": {
        "workflowId": { "enum": ["execution-profile-select", "question-answer", "plan-confirm"] },
        "fake": { "$ref": "#/$defs/sourceResult" },
        "real": { "$ref": "#/$defs/sourceResult" }
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["succeeded", "unsupported", "unavailable", "failed"],
      "properties": {
        "succeeded": { "type": "integer", "minimum": 0, "maximum": 3 },
        "unsupported": { "type": "integer", "minimum": 0, "maximum": 3 },
        "unavailable": { "type": "integer", "minimum": 0, "maximum": 3 },
        "failed": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    }
  }
}
