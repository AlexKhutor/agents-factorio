{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/workflow-checkpoint.v1.json",
  "title": "Rebuildable workflow checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "checkpointId", "sourceId", "taskId",
    "task", "workflow", "confirmedPlan", "returnPolicy", "executions",
    "report", "acceptance", "dependencies", "interventions", "adapterState",
    "freshness", "nextActions", "sourceReceipts", "causalEventIds",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.1.0" },
    "checkpointId": {
      "type": "string",
      "pattern": "^workflow-checkpoint-[a-f0-9]{64}$"
    },
    "sourceId": { "$ref": "#/$defs/identifier" },
    "taskId": { "$ref": "#/$defs/identifier" },
    "task": { "$ref": "#/$defs/fact" },
    "workflow": { "$ref": "#/$defs/fact" },
    "confirmedPlan": { "$ref": "#/$defs/fact" },
    "returnPolicy": { "$ref": "#/$defs/fact" },
    "executions": { "$ref": "#/$defs/fact" },
    "report": { "$ref": "#/$defs/fact" },
    "acceptance": { "$ref": "#/$defs/fact" },
    "dependencies": { "$ref": "#/$defs/fact" },
    "interventions": { "$ref": "#/$defs/fact" },
    "adapterState": { "$ref": "#/$defs/fact" },
    "freshness": { "$ref": "#/$defs/freshness" },
    "nextActions": { "$ref": "#/$defs/fact" },
    "sourceReceipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/sourceReceipt" }
    },
    "causalEventIds": { "$ref": "#/$defs/causalIds" },
    "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "Z$"
    },
    "causalIds": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^causal-event-[a-f0-9]{64}$"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "allOf": [
          { "$ref": "external-reference.schema.json" },
          {
            "properties": {
              "kind": { "const": "artifact" },
              "authority": {
                "allOf": [
                  { "$ref": "authority-reference.schema.json" },
                  { "required": ["artifactSha256"] }
                ]
              }
            }
          }
        ]
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "reasonCode", "observedAtUtc", "authorities",
        "evidenceRefs", "causalEventIds", "value"
      ],
      "properties": {
        "state": {
          "enum": ["current", "stale", "unknown", "unavailable", "contradictory"]
        },
        "reasonCode": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "observedAtUtc": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utc" }]
        },
        "authorities": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "authority-reference.schema.json" }
        },
        "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
        "causalEventIds": { "$ref": "#/$defs/causalIds" },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "object" },
            { "type": "array" }
          ]
        }
      }
    },
    "sourceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "observedAtUtc", "artifactSha256", "sourceSequence"],
      "properties": {
        "authority": { "$ref": "authority-reference.schema.json" },
        "observedAtUtc": { "$ref": "#/$defs/utc" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "sourceSequence": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "evaluatedAtUtc", "oldestObservedAtUtc",
        "agentHeartbeatAtUtc", "semanticChangedAtUtc", "backendPublishedAtUtc",
        "staleAfterSeconds"
      ],
      "properties": {
        "status": {
          "enum": ["fresh", "stale", "unknown", "unavailable", "contradictory"]
        },
        "evaluatedAtUtc": { "$ref": "#/$defs/utc" },
        "oldestObservedAtUtc": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utc" }]
        },
        "agentHeartbeatAtUtc": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utc" }]
        },
        "semanticChangedAtUtc": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utc" }]
        },
        "backendPublishedAtUtc": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/utc" }]
        },
        "staleAfterSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    }
  }
}
