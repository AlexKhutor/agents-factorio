{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/controller-wake-observer-status.v1.schema.json",
  "title": "Controller wake observer status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "instanceId", "processId", "statusHostProcessId",
    "startedAtUtc", "state", "health", "scan", "queue", "retry",
    "problem", "nextScanAtUtc", "updatedAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "instanceId": { "type": "string", "format": "uuid" },
    "processId": { "type": "integer", "minimum": 1 },
    "statusHostProcessId": { "type": ["integer", "null"], "minimum": 1 },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "state": {
      "enum": [
        "watching", "scanning", "processing", "waiting-controller",
        "backoff", "attention-required", "stopped"
      ]
    },
    "health": { "enum": ["ready", "busy", "waiting", "needs-user", "stopped"] },
    "scan": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["scannedBindings", "signalsFound", "queued", "duplicates", "problems"],
          "properties": {
            "scannedBindings": { "type": "integer", "minimum": 0 },
            "signalsFound": { "type": "integer", "minimum": 0 },
            "queued": { "type": "integer", "minimum": 0 },
            "duplicates": { "type": "integer", "minimum": 0 },
            "problems": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["sourceId", "taskId", "code", "message"],
                "properties": {
                  "sourceId": { "type": "string", "maxLength": 64 },
                  "taskId": { "type": "string", "maxLength": 96 },
                  "code": { "type": "string", "maxLength": 128 },
                  "message": { "type": "string", "maxLength": 1024 }
                }
              }
            }
          }
        }
      ]
    },
    "queue": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "stage", "eventId", "sourceId", "taskId", "updatedAtUtc"],
          "properties": {
            "state": { "type": ["string", "null"], "maxLength": 64 },
            "stage": { "type": ["string", "null"], "maxLength": 64 },
            "eventId": { "type": ["string", "null"], "maxLength": 64 },
            "sourceId": { "type": ["string", "null"], "maxLength": 64 },
            "taskId": { "type": ["string", "null"], "maxLength": 96 },
            "updatedAtUtc": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      ]
    },
    "retry": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempt", "maxAttempts", "problem", "nextAttemptAtUtc"],
          "properties": {
            "attempt": { "type": "integer", "minimum": 0 },
            "maxAttempts": { "type": "integer", "minimum": 1 },
            "problem": { "$ref": "#/$defs/problem" },
            "nextAttemptAtUtc": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      ]
    },
    "problem": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/problem" }
      ]
    },
    "nextScanAtUtc": { "type": ["string", "null"], "format": "date-time" },
    "updatedAtUtc": { "type": "string", "format": "date-time" },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requestedAtUtc", "completedAtUtc"],
      "properties": {
        "mode": { "enum": ["forced-after-verified-timeout"] },
        "requestedAtUtc": { "type": "string", "format": "date-time" },
        "completedAtUtc": { "type": "string", "format": "date-time" }
      }
    }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    }
  }
}
