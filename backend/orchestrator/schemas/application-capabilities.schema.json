{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-capabilities.v2.json",
  "title": "Application Capability Descriptor v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "descriptorId", "sourceId",
    "sequence", "publishedAtUtc", "validForSeconds", "authority",
    "contractRefs", "surface", "providerOperations", "providerStates",
    "authenticationStates", "compatibility", "extensions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.2.0" },
    "descriptorId": {
      "type": "string",
      "pattern": "^application-capabilities:[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
    },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "publishedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 64
    },
    "validForSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "authority": { "$ref": "https://isolate-vscode.local/schemas/authority-reference.v1.json" },
    "contractRefs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contractRef" },
      "allOf": [
        { "contains": { "type": "object", "properties": { "contractId": { "const": "application-contract" }, "contractVersion": { "const": "v0.1.0" }, "role": { "const": "application-boundary" } }, "required": ["contractId", "contractVersion", "role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "contractId": { "const": "work-projection-v2" }, "contractVersion": { "const": "v0.2.0" }, "role": { "const": "semantic-projection" } }, "required": ["contractId", "contractVersion", "role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "contractId": { "const": "application-resource" }, "contractVersion": { "const": "v0.1.0" }, "role": { "const": "application-boundary" } }, "required": ["contractId", "contractVersion", "role"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "type": "object", "properties": { "contractId": { "const": "backend-consumer" }, "contractVersion": { "const": "v0.1.0" }, "role": { "const": "compatibility-read" } }, "required": ["contractId", "contractVersion", "role"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "surface": {
      "$ref": "https://isolate-vscode.local/schemas/application-capability-surface.v1.json"
    },
    "providerOperations": {
      "$ref": "https://isolate-vscode.local/schemas/application-provider-operations.v1.json"
    },
    "providerStates": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "https://isolate-vscode.local/schemas/application-provider-state.v1.json" }
    },
    "authenticationStates": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "https://isolate-vscode.local/schemas/application-authentication-state.v1.json" }
    },
    "compatibility": {
      "$ref": "https://isolate-vscode.local/schemas/application-compatibility.v1.json"
    },
    "extensions": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,95}$" }
    }
  },
  "$defs": {
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractId", "contractVersion", "role", "schemaIds"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "contractVersion": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "role": { "enum": ["application-boundary", "semantic-projection", "compatibility-read"] },
        "schemaIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://isolate-vscode\\.local/schemas/[A-Za-z0-9._-]{1,128}$"
          }
        }
      }
    }
  }
}
