{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/adapter-operation-request.v1.json",
  "title": "Adapter operation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "operation", "operationId", "correlationId",
    "requestedAtUtc", "taskBinding", "profile", "subjectRefs",
    "requiredCapabilities", "parameters"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.3.0" },
    "operation": { "$ref": "adapter-common.schema.json#/$defs/operation" },
    "operationId": { "$ref": "adapter-common.schema.json#/$defs/id" },
    "correlationId": { "$ref": "adapter-common.schema.json#/$defs/id" },
    "requestedAtUtc": { "$ref": "adapter-common.schema.json#/$defs/utc" },
    "taskBinding": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "adapter-common.schema.json#/$defs/taskBinding" }
      ]
    },
    "profile": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "adapter-common.schema.json#/$defs/profile" }
      ]
    },
    "subjectRefs": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": { "$ref": "external-reference.schema.json" }
    },
    "requiredCapabilities": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "adapter-common.schema.json#/$defs/requirement" }
    },
    "parameters": { "type": "object", "maxProperties": 64 }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "startExecution" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "taskBinding": { "$ref": "adapter-common.schema.json#/$defs/taskBinding" },
          "subjectRefs": { "type": "array", "maxItems": 1 },
          "requiredCapabilities": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "operation": { "const": "startExecution" },
                "requiredGuarantees": {
                  "type": "array", "contains": { "const": "exact-task-binding" }
                }
              },
              "required": ["operation", "requiredGuarantees"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": { "const": "startExecution" },
          "profile": { "type": "object" }
        },
        "required": ["operation", "profile"]
      },
      "then": {
        "properties": {
          "requiredCapabilities": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "operation": { "const": "startExecution" },
                "requiredGuarantees": {
                  "type": "array", "contains": { "const": "exact-profile-binding" }
                }
              },
              "required": ["operation", "requiredGuarantees"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "readThread", "forkThread", "observeLifecycle",
              "interruptExecution", "resumeExecution", "cancelExecution"
            ]
          }
        },
        "required": ["operation"]
      },
      "then": { "properties": { "subjectRefs": { "type": "array", "minItems": 1, "maxItems": 1 } } }
    }
  ]
}
