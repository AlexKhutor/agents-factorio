{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-provider-operations.v1.json",
  "title": "Application Provider Operation Catalog v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractVersion", "definitions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.1.0" },
    "definitions": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": { "$ref": "#/$defs/definition" }
    }
  },
  "$defs": {
    "resourceKind": {
      "enum": [
        "work-projection", "backend-snapshot", "provider-thread", "provider-turn",
        "provider-item", "artifact", "project-file", "project-directory",
        "review-operation", "change-proposal", "command", "interaction", "receipt", "event"
      ]
    },
    "adapterOperation": {
      "enum": [
        "discoverCapabilities", "listModels", "listExecutions", "readExecution",
        "observeLifecycle", "createSession", "listThreads", "readThread",
        "createThread", "forkThread", "startExecution", "interruptExecution",
        "resumeExecution", "cancelExecution", "prepareContext", "compactContext",
        "getUsage", "openVisibleSurface"
      ]
    },
    "adapterBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["adapterFamily", "adapterContractVersion", "operation"],
      "properties": {
        "adapterFamily": { "const": "execution-provider" },
        "adapterContractVersion": { "const": "v0.3.0" },
        "operation": { "$ref": "#/$defs/adapterOperation" }
      }
    },
    "definition": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "resourceKinds", "adapterBinding"],
      "properties": {
        "operation": { "$ref": "https://isolate-vscode.local/schemas/application-operation-ref.v1.json" },
        "resourceKinds": {
          "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": { "$ref": "#/$defs/resourceKind" }
        },
        "adapterBinding": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/adapterBinding" }
          ]
        }
      }
    }
  }
}
