{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agents-factorio.dev/schemas/smoke-repair-loop-state-v1.json",
  "title": "Smoke repair loop runtime state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "loopId", "enabled", "state", "generation", "boundChat", "active", "incidents", "testTaskIds", "transitions", "updatedAtUtc"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "loopId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
    "enabled": { "type": "boolean" },
    "state": {
      "enum": ["awaiting-maintenance-chat", "ready", "repair-dispatch-ready", "repair-running", "repair-accepted", "retest-running", "passed", "attention-required", "disabled"]
    },
    "generation": { "type": "integer", "minimum": 0, "maximum": 3 },
    "boundChat": { "type": ["object", "null"] },
    "active": { "type": ["object", "null"] },
    "incidents": { "type": "array", "maxItems": 3, "items": { "type": "object" } },
    "testTaskIds": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" }
    },
    "transitions": { "type": "array", "maxItems": 64, "items": { "type": "object" } },
    "updatedAtUtc": { "type": "string", "format": "date-time" }
  }
}
