{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/child-wake-signal.v1.schema.json",
  "title": "Child report-ready signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "eventType", "sourceId", "taskId", "taskSha256",
    "returnBindingId", "reportStatus", "reportMetadataSha256", "occurredAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "eventType": { "const": "child-report-ready" },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
    "taskSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "returnBindingId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reportStatus": { "enum": ["completed", "blocked", "failed"] },
    "reportMetadataSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "occurredAtUtc": { "type": "string", "format": "date-time" }
  }
}
