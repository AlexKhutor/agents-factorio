{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-capability-surface.v1.json",
  "title": "Application Capability Surface v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resourceKinds", "operations", "limits", "schemas", "transports"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "resourceKinds": {
      "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
      "items": { "$ref": "#/$defs/resourceKind" }
    },
    "operations": {
      "type": "object", "additionalProperties": false,
      "required": ["discovery", "query", "subscription", "proposal", "approval", "mutation", "receipt-lookup"],
      "properties": {
        "discovery": { "$ref": "#/$defs/operationList" },
        "query": { "$ref": "#/$defs/operationList" },
        "subscription": { "$ref": "#/$defs/operationList" },
        "proposal": { "$ref": "#/$defs/operationList" },
        "approval": { "$ref": "#/$defs/operationList" },
        "mutation": { "$ref": "#/$defs/operationList" },
        "receipt-lookup": { "$ref": "#/$defs/operationList" }
      }
    },
    "limits": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/limit" }
    },
    "schemas": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": { "$ref": "#/$defs/schemaRef" }
    },
    "transports": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": { "$ref": "#/$defs/transport" }
    }
  },
  "$defs": {
    "resourceKind": {
      "enum": [
        "work-projection", "backend-snapshot", "provider-thread", "provider-turn",
        "provider-item", "artifact", "project-file", "project-directory",
        "review-operation", "change-proposal", "command", "interaction", "receipt", "event"
      ]
    },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "contractId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["contractId", "contractVersion", "operationId", "transportId"],
      "properties": {
        "contractId": { "$ref": "#/$defs/contractId" },
        "contractVersion": { "$ref": "#/$defs/version" },
        "operationId": { "$ref": "#/$defs/identifier" },
        "transportId": { "$ref": "#/$defs/contractId" }
      }
    },
    "operationEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "resourceKinds", "binding"],
      "properties": {
        "operation": { "$ref": "https://isolate-vscode.local/schemas/application-operation-ref.v1.json" },
        "resourceKinds": {
          "type": "array", "maxItems": 8, "uniqueItems": true,
          "items": { "$ref": "#/$defs/resourceKind" }
        },
        "binding": { "$ref": "#/$defs/binding" }
      }
    },
    "operationList": {
      "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/operationEntry" }
    },
    "limit": {
      "type": "object", "additionalProperties": false,
      "required": ["limitId", "value", "unit"],
      "properties": {
        "limitId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
        "value": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "unit": { "enum": ["bytes", "count"] }
      }
    },
    "schemaRef": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaId", "contractId", "contractVersion"],
      "properties": {
        "schemaId": { "type": "string", "pattern": "^https://isolate-vscode\\.local/schemas/[A-Za-z0-9._-]{1,128}$" },
        "contractId": { "$ref": "#/$defs/contractId" },
        "contractVersion": { "$ref": "#/$defs/version" }
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["transportId", "access", "scope", "operationFamilies"],
      "properties": {
        "transportId": { "$ref": "#/$defs/contractId" },
        "access": { "enum": ["read-only", "write"] },
        "scope": { "const": "windows-user-machine-local" },
        "operationFamilies": {
          "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
          "items": { "enum": ["discovery", "query", "subscription", "proposal", "approval", "mutation", "receipt-lookup"] }
        }
      }
    }
  }
}
