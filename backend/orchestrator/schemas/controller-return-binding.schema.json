{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/controller-return-binding.v1.schema.json",
  "title": "Machine-local controller return binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "bindingId", "scope", "sourceId", "taskId",
    "taskSha256", "controllerRoot", "controllerCodexHome",
    "controllerThreadId", "childWorkspaceFingerprint", "createdAtUtc",
    "expiresAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bindingId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": { "const": "single-machine" },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
    "taskSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "controllerRoot": { "type": "string", "minLength": 3, "maxLength": 1024 },
    "controllerCodexHome": { "type": "string", "minLength": 3, "maxLength": 1024 },
    "controllerThreadId": { "type": "string", "pattern": "^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$" },
    "reportOperation": { "enum": ["accept", "show", "summarize", "review", "import-only"] },
    "continuationPolicy": {
      "enum": ["stop-after-report", "continue-confirmed-plan", "require-user-decision"]
    },
    "controllerPlan": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "sha256", "confirmedBy", "confirmedAtUtc"],
          "properties": {
            "revision": { "type": "integer", "minimum": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "confirmedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
            "confirmedAtUtc": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "smokeRepairLoop": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["loopId", "generation"],
          "properties": {
            "loopId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
            "generation": { "type": "integer", "minimum": 1, "maximum": 3 }
          }
        }
      ]
    },
    "reportPresentation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "reasoningEffort", "language"],
          "properties": {
            "model": { "type": ["string", "null"], "maxLength": 128 },
            "reasoningEffort": { "type": ["string", "null"], "maxLength": 32 },
            "language": { "type": ["string", "null"], "maxLength": 64 }
          }
        }
      ]
    },
    "childWorkspaceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" }
  }
}
