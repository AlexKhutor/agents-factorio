{
  "name": "@isolate-vscode/application-frontend-kit",
  "version": "0.21.0",
  "description": "Renderer-neutral contracts and integration assets for the Agents Factorio Application Gateway",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/client/index.mjs",
      "default": "./dist/client/index.mjs"
    },
    "./client": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/client/index.mjs",
      "default": "./dist/client/index.mjs"
    },
    "./testing": "./dist/testing/index.mjs",
    "./testing/agent-workspace": "./dist/testing/agent-workspace.mjs",
    "./desktop": "./dist/desktop/index.mjs",
    "./diagnostics": "./dist/diagnostics/index.mjs",
    "./compatibility": "./dist/compatibility/index.mjs",
    "./manifest": "./dist/manifest.json",
    "./errors": "./dist/errors/error-catalog.v1.json",
    "./capabilities-example": "./dist/examples/capabilities.discovery.v1.json",
    "./schemas/*": "./dist/schemas/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../scripts/build-application-frontend-kit.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
