{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agents-factorio.dev/schemas/task-definition-compatible-v3.json",
  "title": "Coordinator task definition",
  "oneOf": [
    { "$ref": "#/$defs/legacyV1" },
    { "$ref": "#/$defs/intentV2" },
    { "$ref": "#/$defs/confirmedIntentV3" }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "artifactReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path"],
        "properties": {
          "kind": { "enum": ["file", "image", "audio", "video", "directory", "log"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "executionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoningEffort", "fallbackPolicy"],
      "properties": {
        "provider": { "const": "openai" },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasoningEffort": { "type": "string", "minLength": 1, "maxLength": 32 },
        "fallbackPolicy": { "const": "deny" }
      }
    },
    "legacyV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "targetId",
        "title",
        "objective",
        "responsibilityBoundary",
        "acceptanceCriteria",
        "requiredReading",
        "allowedPaths",
        "forbiddenPaths",
        "constraints",
        "deliverables"
      ],
      "properties": {
        "contractVersion": { "const": "v0.1.0" },
        "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
        "targetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "objective": { "type": "string", "minLength": 1 },
        "responsibilityBoundary": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["low", "normal", "high", "critical"] },
        "acceptanceCriteria": { "$ref": "#/$defs/nonEmptyStringArray" },
        "requiredReading": { "$ref": "#/$defs/stringArray" },
        "allowedPaths": { "$ref": "#/$defs/stringArray" },
        "forbiddenPaths": { "$ref": "#/$defs/stringArray" },
        "constraints": { "$ref": "#/$defs/stringArray" },
        "deliverables": { "$ref": "#/$defs/nonEmptyStringArray" },
        "allowSubagents": { "type": "boolean" },
        "artifactReferences": { "$ref": "#/$defs/artifactReferences" }
      }
    },
    "intentV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "taskId",
        "targetId",
        "title",
        "intent",
        "desiredOutcomes",
        "responsibilityBoundary",
        "requiredReading",
        "forbiddenPaths",
        "constraints",
        "deliverables"
      ],
      "properties": {
        "contractVersion": { "const": "v0.2.0" },
        "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
        "targetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "intent": { "type": "string", "minLength": 1 },
        "desiredOutcomes": { "$ref": "#/$defs/nonEmptyStringArray" },
        "responsibilityBoundary": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["low", "normal", "high", "critical"] },
        "requiredReading": { "$ref": "#/$defs/stringArray" },
        "forbiddenPaths": { "$ref": "#/$defs/stringArray" },
        "constraints": { "$ref": "#/$defs/stringArray" },
        "deliverables": { "$ref": "#/$defs/nonEmptyStringArray" },
        "allowSubagents": { "type": "boolean" },
        "executionProfile": { "$ref": "#/$defs/executionProfile" },
        "artifactReferences": { "$ref": "#/$defs/artifactReferences" }
      }
    },
    "confirmedIntentV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "workflowPolicy",
        "intentConfirmation",
        "taskId",
        "targetId",
        "title",
        "intent",
        "desiredOutcomes",
        "responsibilityBoundary",
        "requiredReading",
        "forbiddenPaths",
        "constraints",
        "deliverables"
      ],
      "properties": {
        "contractVersion": { "const": "v0.3.0" },
        "workflowPolicy": { "const": "intent-confirm-plan-v1" },
        "intentConfirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "confirmedBy", "confirmedAtUtc"],
          "properties": {
            "status": { "const": "confirmed" },
            "confirmedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
            "confirmedAtUtc": { "type": "string", "format": "date-time" },
            "note": { "type": ["string", "null"], "maxLength": 512 }
          }
        },
        "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
        "targetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "intent": { "type": "string", "minLength": 1 },
        "desiredOutcomes": { "$ref": "#/$defs/nonEmptyStringArray" },
        "responsibilityBoundary": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["low", "normal", "high", "critical"] },
        "requiredReading": { "$ref": "#/$defs/stringArray" },
        "forbiddenPaths": { "$ref": "#/$defs/stringArray" },
        "constraints": { "$ref": "#/$defs/stringArray" },
        "deliverables": { "$ref": "#/$defs/nonEmptyStringArray" },
        "allowSubagents": { "type": "boolean" },
        "executionProfile": { "$ref": "#/$defs/executionProfile" },
        "artifactReferences": { "$ref": "#/$defs/artifactReferences" }
      }
    }
  }
}
