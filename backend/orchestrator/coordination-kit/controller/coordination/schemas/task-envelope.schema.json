{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.agents-factorio.dev/schemas/task-envelope-compatible-v3.json",
  "title": "Dispatched child task",
  "oneOf": [
    { "$ref": "#/$defs/legacyV1" },
    { "$ref": "#/$defs/intentV2" },
    { "$ref": "#/$defs/confirmedIntentV3" }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "executionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "reasoningEffort", "fallbackPolicy"],
      "properties": {
        "provider": { "const": "openai" },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reasoningEffort": { "type": "string", "minLength": 1, "maxLength": 32 },
        "fallbackPolicy": { "const": "deny" }
      }
    },
    "legacyV1": {
      "type": "object",
      "required": [
        "schemaVersion",
        "contractVersion",
        "taskId",
        "coordinatorId",
        "targetId",
        "title",
        "objective",
        "responsibilityBoundary",
        "definitionSha256",
        "dispatchedAtUtc",
        "executionAdapter",
        "executionState",
        "agentTurnStarted",
        "reportContract"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractVersion": { "const": "v0.1.0" },
        "taskId": { "type": "string" },
        "coordinatorId": { "type": "string" },
        "targetId": { "type": "string" },
        "definitionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "executionAdapter": { "type": "string" },
        "executionState": { "const": "awaiting-child-agent-acceptance" },
        "agentTurnStarted": { "const": false }
      }
    },
    "intentV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contractVersion",
        "taskId",
        "coordinatorId",
        "targetId",
        "title",
        "intent",
        "desiredOutcomes",
        "responsibilityBoundary",
        "priority",
        "requiredReading",
        "forbiddenPaths",
        "constraints",
        "deliverables",
        "artifactReferences",
        "allowSubagents",
        "executionAuthority",
        "definitionSha256",
        "dispatchedAtUtc",
        "executionAdapter",
        "executionState",
        "agentTurnStarted",
        "reportContract"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractVersion": { "const": "v0.2.0" },
        "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
        "coordinatorId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "intent": { "type": "string", "minLength": 1 },
        "desiredOutcomes": { "$ref": "#/$defs/nonEmptyStringArray" },
        "responsibilityBoundary": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["low", "normal", "high", "critical"] },
        "requiredReading": { "$ref": "#/$defs/stringArray" },
        "forbiddenPaths": { "$ref": "#/$defs/stringArray" },
        "constraints": { "$ref": "#/$defs/stringArray" },
        "deliverables": { "$ref": "#/$defs/nonEmptyStringArray" },
        "artifactReferences": { "type": "array" },
        "allowSubagents": { "type": "boolean" },
        "executionProfile": { "$ref": "#/$defs/executionProfile" },
        "executionAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementationOwner", "localValidationOwner", "crossProjectAcceptanceOwner"],
          "properties": {
            "implementationOwner": { "const": "target" },
            "localValidationOwner": { "const": "target" },
            "crossProjectAcceptanceOwner": { "const": "coordinator" }
          }
        },
        "definitionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dispatchedAtUtc": { "type": "string", "format": "date-time" },
        "executionAdapter": { "type": "string", "minLength": 1 },
        "executionState": { "const": "awaiting-child-agent-acceptance" },
        "agentTurnStarted": { "const": false },
        "reportContract": { "type": "object" }
      }
    },
    "confirmedIntentV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "contractVersion",
        "workflowPolicy",
        "intentConfirmation",
        "taskId",
        "coordinatorId",
        "targetId",
        "title",
        "intent",
        "desiredOutcomes",
        "responsibilityBoundary",
        "priority",
        "requiredReading",
        "forbiddenPaths",
        "constraints",
        "deliverables",
        "artifactReferences",
        "allowSubagents",
        "executionAuthority",
        "definitionSha256",
        "dispatchedAtUtc",
        "executionAdapter",
        "executionState",
        "agentTurnStarted",
        "reportContract"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractVersion": { "const": "v0.3.0" },
        "workflowPolicy": { "const": "intent-confirm-plan-v1" },
        "intentConfirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "confirmedBy", "confirmedAtUtc"],
          "properties": {
            "status": { "const": "confirmed" },
            "confirmedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
            "confirmedAtUtc": { "type": "string", "format": "date-time" },
            "note": { "type": ["string", "null"], "maxLength": 512 }
          }
        },
        "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$" },
        "coordinatorId": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "intent": { "type": "string", "minLength": 1 },
        "desiredOutcomes": { "$ref": "#/$defs/nonEmptyStringArray" },
        "responsibilityBoundary": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["low", "normal", "high", "critical"] },
        "requiredReading": { "$ref": "#/$defs/stringArray" },
        "forbiddenPaths": { "$ref": "#/$defs/stringArray" },
        "constraints": { "$ref": "#/$defs/stringArray" },
        "deliverables": { "$ref": "#/$defs/nonEmptyStringArray" },
        "artifactReferences": { "type": "array" },
        "allowSubagents": { "type": "boolean" },
        "executionProfile": { "$ref": "#/$defs/executionProfile" },
        "executionAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementationOwner", "localValidationOwner", "crossProjectAcceptanceOwner"],
          "properties": {
            "implementationOwner": { "const": "target" },
            "localValidationOwner": { "const": "target" },
            "crossProjectAcceptanceOwner": { "const": "coordinator" }
          }
        },
        "definitionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dispatchedAtUtc": { "type": "string", "format": "date-time" },
        "executionAdapter": { "type": "string", "minLength": 1 },
        "executionState": { "const": "awaiting-child-agent-acceptance" },
        "agentTurnStarted": { "const": false },
        "reportContract": { "type": "object" }
      }
    }
  }
}
