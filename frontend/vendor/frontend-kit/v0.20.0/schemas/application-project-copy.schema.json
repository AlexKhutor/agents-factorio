{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-project-copy.schema.json",
  "title": "Application Project Copy v0.1.0",
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "input": { "type": "object", "additionalProperties": false,
      "required": ["sourceProjectId", "targetProjectId", "targetProjectScopeId", "quarterScopeIds", "operationId"],
      "properties": {
        "sourceProjectId": { "$ref": "#/$defs/id" },
        "targetProjectId": { "$ref": "#/$defs/id" },
        "targetProjectScopeId": { "$ref": "#/$defs/id" },
        "quarterScopeIds": { "type": "object", "maxProperties": 511,
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/id" } },
        "operationId": { "$ref": "#/$defs/id" }
      } },
    "request": { "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "operationId", "input"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractVersion": { "const": "v0.1.0" },
        "operationId": { "const": "mutation.memory.project.copy" },
        "input": { "$ref": "#/$defs/input" }
      } },
    "scopeReceipt": { "type": "object", "additionalProperties": false,
      "required": ["sourceScopeId", "targetScopeId", "kind", "quarterId",
        "sourceRevision", "sourceSha256", "targetRevision", "targetSha256"],
      "properties": {
        "sourceScopeId": { "$ref": "#/$defs/id" },
        "targetScopeId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["project", "quarter"] },
        "quarterId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "sourceRevision": { "type": "integer", "minimum": 1 },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "targetRevision": { "const": 1 },
        "targetSha256": { "$ref": "#/$defs/sha256" }
      } },
    "receipt": { "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "outcome", "sourceProjectId", "targetProjectId",
        "operationId", "scopes", "copiedAtUtc"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "outcome": { "const": "complete" },
        "sourceProjectId": { "$ref": "#/$defs/id" },
        "targetProjectId": { "$ref": "#/$defs/id" },
        "operationId": { "$ref": "#/$defs/id" },
        "scopes": { "type": "array", "minItems": 1, "maxItems": 512,
          "items": { "$ref": "#/$defs/scopeReceipt" } },
        "copiedAtUtc": { "type": "string", "format": "date-time" }
      } }
  }
}
