{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-concept-map.v1.json",
  "title": "Application Concept Map v0.1",
  "type": "array",
  "minItems": 7,
  "maxItems": 7,
  "uniqueItems": true,
  "items": { "$ref": "#/$defs/mapping" },
  "allOf": [
    { "contains": { "type": "object", "properties": { "conceptId": { "const": "work-projection" } }, "required": ["conceptId"] }, "minContains": 1, "maxContains": 1 },
    { "contains": { "type": "object", "properties": { "conceptId": { "const": "backend-consumer" } }, "required": ["conceptId"] }, "minContains": 1, "maxContains": 1 },
    { "contains": { "type": "object", "properties": { "conceptId": { "const": "provider-conversation" } }, "required": ["conceptId"] }, "minContains": 1, "maxContains": 1 },
    { "contains": { "type": "object", "properties": { "conceptId": { "const": "artifact" } }, "required": ["conceptId"] }, "minContains": 1, "maxContains": 1 },
    { "contains": { "type": "object", "properties": { "conceptId": { "const": "project-resource" } }, "required": ["conceptId"] }, "minContains": 1, "maxContains": 1 },
    { "contains": { "type": "object", "properties": { "conceptId": { "const": "review" } }, "required": ["conceptId"] }, "minContains": 1, "maxContains": 1 },
    { "contains": { "type": "object", "properties": { "conceptId": { "const": "command" } }, "required": ["conceptId"] }, "minContains": 1, "maxContains": 1 }
  ],
  "$defs": {
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "contractVersion", "conceptId", "resourceKinds",
        "sourceContractIds", "authorityTypes", "authorityRule", "operationFamilies"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contractVersion": { "const": "v0.1.0" },
        "conceptId": {
          "enum": [
            "work-projection", "backend-consumer", "provider-conversation",
            "artifact", "project-resource", "review", "command"
          ]
        },
        "resourceKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "https://isolate-vscode.local/schemas/application-common.v1.json#/$defs/resourceKind"
          }
        },
        "sourceContractIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}/v[0-9]+\\.[0-9]+\\.[0-9]+$"
          }
        },
        "authorityTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "human", "provider", "coordination-core", "child-workspace",
              "git-repository", "external-semantic-source", "presentation"
            ]
          }
        },
        "authorityRule": {
          "enum": [
            "resource-owner", "per-fact-provenance",
            "working-tree-or-repository", "operation-owner"
          ]
        },
        "operationFamilies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "https://isolate-vscode.local/schemas/application-common.v1.json#/$defs/operationFamily"
          }
        }
      }
    }
  }
}
