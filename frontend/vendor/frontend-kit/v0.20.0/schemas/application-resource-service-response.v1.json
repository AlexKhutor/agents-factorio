{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-resource-service-response.v1.json",
  "title": "Application Resource Service Response v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "operation", "status", "summary",
    "read", "continuation", "error"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.1.0" },
    "operation": { "enum": ["summary", "full", "slice"] },
    "status": { "enum": ["succeeded", "continuation-required"] },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": [
        "resourceKind", "relativePath", "authoritySha256", "observedRevision",
        "requestSha256", "sourceBinding", "contentSha256", "mediaType",
        "totalBytes", "totalEntries", "readAtUtc"
      ],
      "properties": {
        "resourceKind": {
          "enum": ["artifact", "project-file", "project-directory"]
        },
        "relativePath": {
          "$ref": "https://isolate-vscode.local/schemas/application-common.v1.json#/$defs/nativeId"
        },
        "authoritySha256": { "$ref": "#/$defs/sha256" },
        "observedRevision": {
          "$ref": "https://isolate-vscode.local/schemas/application-common.v1.json#/$defs/revision"
        },
        "requestSha256": { "$ref": "#/$defs/sha256" },
        "sourceBinding": {
          "type": "object", "additionalProperties": false,
          "required": ["rootId", "rootIdentitySha256", "readPolicyId", "readPolicySha256"],
          "properties": {
            "rootId": { "$ref": "#/$defs/id" },
            "rootIdentitySha256": { "$ref": "#/$defs/sha256" },
            "readPolicyId": { "$ref": "#/$defs/id" },
            "readPolicySha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "mediaType": { "type": "string", "minLength": 1, "maxLength": 128 },
        "totalBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "totalEntries": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          ]
        },
        "readAtUtc": { "type": "string", "format": "date-time", "maxLength": 64 }
      }
    },
    "read": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://isolate-vscode.local/schemas/application-resource-read-result.v1.json" }
      ]
    },
    "continuation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["token", "expiresAtUtc"],
          "properties": {
            "token": { "type": "string", "minLength": 1, "maxLength": 8192 },
            "expiresAtUtc": { "type": "string", "format": "date-time", "maxLength": 64 }
          }
        }
      ]
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["code", "message", "retryable", "phase", "nextAction"],
          "properties": {
            "code": { "const": "continuation_required" },
            "message": { "type": "string", "minLength": 1, "maxLength": 512 },
            "retryable": { "const": false },
            "phase": { "const": "observation" },
            "nextAction": { "const": "slice" }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
