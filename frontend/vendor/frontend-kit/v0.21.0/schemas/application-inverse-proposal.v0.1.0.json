{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-inverse-proposal.v0.1.0.json",
  "title": "Application Inverse Proposal v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "inverseId",
    "originalProposalRef",
    "inverseProposal",
    "resourceMappings",
    "createdAtUtc",
    "inverseSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.1.0" },
    "inverseId": { "$ref": "#/$defs/id" },
    "originalProposalRef": { "$ref": "#/$defs/originalProposalRef" },
    "inverseProposal": {
      "$ref": "https://isolate-vscode.local/schemas/application-change-proposal.v0.1.0.json"
    },
    "resourceMappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/resourceMapping" }
    },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "inverseSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "originalProposalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "proposalRevision", "proposalSha256"],
      "properties": {
        "proposalId": { "$ref": "#/$defs/id" },
        "proposalRevision": { "type": "integer", "minimum": 1 },
        "proposalSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "originalChangeId",
        "inverseChangeId",
        "resourceSourceId",
        "resourceNativeId",
        "originalChangeKind",
        "inverseChangeKind",
        "currentContentSha256",
        "restoredContentSha256"
      ],
      "properties": {
        "originalChangeId": { "$ref": "#/$defs/id" },
        "inverseChangeId": { "$ref": "#/$defs/id" },
        "resourceSourceId": {
          "$ref": "https://isolate-vscode.local/schemas/application-common.v1.json#/$defs/sourceId"
        },
        "resourceNativeId": {
          "$ref": "https://isolate-vscode.local/schemas/application-common.v1.json#/$defs/nativeId"
        },
        "originalChangeKind": { "enum": ["create", "update", "delete"] },
        "inverseChangeKind": { "enum": ["create", "update", "delete"] },
        "currentContentSha256": { "$ref": "#/$defs/nullableSha256" },
        "restoredContentSha256": { "$ref": "#/$defs/nullableSha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "originalChangeKind": { "const": "create" } } },
          "then": {
            "properties": {
              "inverseChangeKind": { "const": "delete" },
              "currentContentSha256": { "$ref": "#/$defs/sha256" },
              "restoredContentSha256": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "originalChangeKind": { "const": "delete" } } },
          "then": {
            "properties": {
              "inverseChangeKind": { "const": "create" },
              "currentContentSha256": { "type": "null" },
              "restoredContentSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": { "properties": { "originalChangeKind": { "const": "update" } } },
          "then": {
            "properties": {
              "inverseChangeKind": { "const": "update" },
              "currentContentSha256": { "$ref": "#/$defs/sha256" },
              "restoredContentSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      ]
    }
  }
}
