{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isolate-vscode.local/schemas/application-interaction-request.v0.1.0.json",
  "title": "Application Interaction Request v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "contractVersion", "requestId", "requestType", "mode",
    "owner", "target", "requestRevision", "sourceSequence", "contextSha256",
    "allowedResponses", "requestedAtUtc", "expiresAtUtc", "requestSha256"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "v0.1.0" },
    "requestId": { "$ref": "#/$defs/id" },
    "requestType": {
      "enum": [
        "intent-clarification", "plan-confirmation", "option-selection",
        "provider-tool-permission", "intervention", "report-decision",
        "high-impact-action-approval", "recommendation", "notification"
      ]
    },
    "mode": {
      "enum": ["decision-required", "recommendation-available", "notification-only"]
    },
    "owner": {
      "allOf": [
        { "$ref": "https://isolate-vscode.local/schemas/application-actor-ref.v1.json" },
        { "type": "object", "properties": { "actorType": { "const": "local-operator" } } }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceId", "taskId", "taskSha256"],
          "properties": {
            "kind": { "const": "task" },
            "sourceId": { "$ref": "#/$defs/sourceId" },
            "taskId": { "$ref": "#/$defs/id" },
            "taskSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceId", "taskId", "executionId"],
          "properties": {
            "kind": { "const": "execution" },
            "sourceId": { "$ref": "#/$defs/sourceId" },
            "taskId": { "$ref": "#/$defs/id" },
            "executionId": { "$ref": "#/$defs/id" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "resourceRef"],
          "properties": {
            "kind": { "const": "resource" },
            "resourceRef": {
              "$ref": "https://isolate-vscode.local/schemas/application-resource-ref.v1.json"
            }
          }
        }
      ]
    },
    "requestRevision": { "type": "integer", "minimum": 1 },
    "sourceSequence": { "type": "integer", "minimum": 0 },
    "contextSha256": { "$ref": "#/$defs/sha256" },
    "allowedResponses": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "requestedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "requestSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$" },
    "sourceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
